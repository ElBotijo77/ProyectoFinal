root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{java,kt,kts,xml}]
indent_size = 4

[*.{yml,yaml,json,js,jsx,ts,tsx,css,html}]
indent_size = 2

# En Markdown dos espacios finales significan salto de línea
[*.md]
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf
